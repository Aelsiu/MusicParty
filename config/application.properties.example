# Copy to config/application.properties before starting Docker Compose.
# This file is mounted into /app/config and read by Spring Boot at startup.
server.port=8080
app.music-api.admin-password=change-me
app.music-api.base-url=http://localhost:8848
app.music-api.author-name=ThorNex & Aelsiu
app.music-api.back-words=MUSIC PARTY
app.music-api.ffmpeg-path=ffmpeg

app.music-api.netease.base-url=http://netease-api:3000
app.music-api.netease.cookie=
app.music-api.netease.quality=exhigh
app.music-api.netease.enabled=true
app.music-api.bilibili.base-url=https://api.bilibili.com
app.music-api.bilibili.cookie=
app.music-api.bilibili.enabled=true
app.music-api.bilibili.max-duration-minutes=10

app.music-api.queue.max-size=1000
app.music-api.queue.history-size=50
app.music-api.queue.max-user-songs=100
app.music-api.queue.persistence-file=data/queue-data.json
app.music-api.queue.persistence-interval-ms=60000
app.music-api.player.max-playlist-import-size=100
app.music-api.player.sync-broadcast-interval-ms=5000
app.music-api.player.vote-skip-enabled=false
app.music-api.player.vote-skip-threshold=0.5
app.music-api.player.vote-skip-wait-time=15
app.music-api.player.idle-kick-enabled=false
app.music-api.player.idle-kick-minutes=15
app.music-api.chat.max-history-size=1000
app.music-api.chat.min-interval-ms=1000
app.music-api.chat.max-message-length=200
app.music-api.cache.max-size=1GB

app.music-api.auth.rate-limit.enabled=true
app.music-api.auth.rate-limit.max-attempts=5
app.music-api.auth.rate-limit.window-seconds=60
app.music-api.auth.rate-limit.block-duration-seconds=300

app.music-api.stream.max-clients=100
app.music-api.stream.buffer-chunks=32
app.music-api.stream.chunk-size-bytes=16384
app.music-api.stream.seek-threshold-ms=3000
app.music-api.stream.emitter-timeout-ms=86400000
